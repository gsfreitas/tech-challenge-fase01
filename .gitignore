# =========================
# Ambiente virtual
# =========================
.env
.venv/
env/
venv/

# =========================
# Python
# =========================
__pycache__/
*.pyc
*.pyo
*.pyd

# =========================
# Build / Packaging
# =========================
*.egg-info/
dist/
build/

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/

# =========================
# MLflow
# =========================
# mlruns/ é o backend antigo (file-based) — agora usamos sqlite mlflow.db
# que DEVE ser versionado pra o Registry funcionar pra todo mundo
mlruns/
**/mlruns/

# =========================
# Dados (não versionar)
# =========================
data/raw/*
data/processed/*

# EXCEÇÃO: permitir gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

# =========================
# Modelos treinados
# =========================
# Modelos vão via GitHub Releases (scripts/download_model.ps1)
models/*.pkl
models/*.pt
models/*.joblib

# =========================
# Tests / Coverage
# =========================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/

# =========================
# Logs / temporários
# =========================
*.log
*.tmp

# =========================
# Sistema operacional
# =========================
.DS_Store
Thumbs.db

# =========================
# VS Code
# =========================
.vscode/
.vscode/.coverage